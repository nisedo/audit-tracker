{
  "name": "auditracker",
  "displayName": "Auditracker",
  "description": "Track code audit progress by marking files in scope and tracking function audit status",
  "version": "0.6.0",
  "publisher": "nisedo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nisedo/auditracker"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "audit",
    "security",
    "code review",
    "solidity",
    "smart contracts",
    "web3",
    "blockchain"
  ],
  "activationEvents": [
    "onView:auditracker.activeFileView",
    "onView:auditracker.filesView",
    "onCommand:auditracker.addToScope",
    "onCommand:auditracker.removeFromScope",
    "onCommand:auditracker.markAudited",
    "onCommand:auditracker.unmarkAudited",
    "onCommand:auditracker.refresh",
    "onCommand:auditracker.goToFunction",
    "onCommand:auditracker.clearAllState",
    "onCommand:auditracker.loadScopeFile",
    "onCommand:auditracker.hideFunction",
    "onCommand:auditracker.showHiddenFunctions",
    "onCommand:auditracker.showProgressReport",
    "onCommand:auditracker.selectFile",
    "workspaceContains:SCOPE.txt",
    "workspaceContains:SCOPE.md",
    "workspaceContains:.vscode/*-auditracker.json"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Auditracker requires a trusted workspace because it reads and writes tracking data under the workspace's .vscode directory."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "auditracker",
          "title": "Auditracker",
          "icon": "$(checklist)"
        }
      ]
    },
    "views": {
      "auditracker": [
        {
          "id": "auditracker.activeFileView",
          "name": "Active File"
        },
        {
          "id": "auditracker.filesView",
          "name": "Files"
        }
      ]
    },
    "commands": [
      {
        "command": "auditracker.addToScope",
        "title": "Auditracker: Add to Scope"
      },
      {
        "command": "auditracker.removeFromScope",
        "title": "Auditracker: Remove from Scope"
      },
      {
        "command": "auditracker.markAudited",
        "title": "Mark as Audited",
        "icon": "$(check)"
      },
      {
        "command": "auditracker.unmarkAudited",
        "title": "Unmark Audited"
      },
      {
        "command": "auditracker.refresh",
        "title": "Auditracker: Refresh"
      },
      {
        "command": "auditracker.goToFunction",
        "title": "Go to Function"
      },
      {
        "command": "auditracker.clearAllState",
        "title": "Auditracker: Clear All Tracking State"
      },
      {
        "command": "auditracker.loadScopeFile",
        "title": "Auditracker: Load Scope File"
      },
      {
        "command": "auditracker.hideFunction",
        "title": "Hide Function"
      },
      {
        "command": "auditracker.showHiddenFunctions",
        "title": "Show Hidden Functions"
      },
      {
        "command": "auditracker.showProgressReport",
        "title": "Auditracker: Show Progress Report"
      },
      {
        "command": "auditracker.selectFile",
        "title": "Auditracker: Select File"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "auditracker.addToScope",
          "group": "audit@1",
          "when": "resourceScheme == file"
        },
        {
          "command": "auditracker.removeFromScope",
          "group": "audit@2",
          "when": "resourceScheme == file"
        }
      ],
      "view/title": [],
      "view/item/context": [
        {
          "command": "auditracker.markAudited",
          "when": "view == auditracker.activeFileView && viewItem == functionUnaudited",
          "group": "inline@1"
        },
        {
          "command": "auditracker.markAudited",
          "when": "view == auditracker.activeFileView && viewItem == functionUnaudited",
          "group": "audit@1"
        },
        {
          "command": "auditracker.unmarkAudited",
          "when": "view == auditracker.activeFileView && viewItem == functionAudited",
          "group": "audit@1"
        },
        {
          "command": "auditracker.hideFunction",
          "when": "view == auditracker.activeFileView && viewItem =~ /^function/",
          "group": "visibility@1"
        },
        {
          "command": "auditracker.removeFromScope",
          "when": "view == auditracker.filesView && viewItem == file",
          "group": "audit@1"
        },
        {
          "command": "auditracker.showHiddenFunctions",
          "when": "view == auditracker.filesView && viewItem == file",
          "group": "visibility@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  }
}
